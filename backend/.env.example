# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL / Supabase) ----
# Supabase -> Project Settings -> Database -> Connection string.
# Leave BLANK to run on the in-memory store (demo still works, data is lost on restart).
#
# IMPORTANT: use the *Session pooler* string, not the direct one. Supabase
# direct connections (db.<ref>.supabase.co:5432) are IPv6-only, and most home
# and college networks are IPv4 — you will get ENETUNREACH. The pooler works
# on both:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase requires TLS. Only set false for a local Postgres without SSL.
DATABASE_SSL=true
# Supabase free tier has a modest connection limit — keep the pool small.
DATABASE_POOL_MAX=5

# ---- Weather / AQI (OpenWeather) ----
# https://openweathermap.org/api  — free tier covers /weather and /air_pollution
OPENWEATHER_API_KEY=
DEFAULT_LAT=22.5726
DEFAULT_LON=88.3639
# Force a fake environment payload for demos (e.g. simulating a heatwave on stage).
# Example: WEATHER_MOCK={"tempC":44,"humidity":68,"aqi":4,"pm25":121,"source":"mock"}
WEATHER_MOCK=

# ---- SMS alerting ----
# One of: console | fast2sms | twilio     (console = dry-run, prints to terminal)
SMS_PROVIDER=console
EMERGENCY_CONTACT=+919999999999

# Fast2SMS (India, free dev credits)
FAST2SMS_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Device auth (simple shared secret for the ESP32) ----
DEVICE_API_KEY=sih26181-dev-key

# ---- Alert timing ----
# How long a condition must hold before it alerts (stops one bad PPG sample
# paging a caregiver).
SUSTAIN_WINDOW_MS=30000
# Don't re-raise the same alert type within this window.
ALERT_COOLDOWN_MS=60000
# Don't re-SMS the same alert type within this window.
SMS_COOLDOWN_MS=300000

# ---- Fall detection (Day 8) ----
# Multi-stage: free fall -> impact -> orientation change -> stillness.
# Tune these to where the device is worn; a wrist and a belt clip do not
# produce the same impact profile.
FALL_FREEFALL_G=0.45          # below this the device is near weightless
FALL_FREEFALL_WINDOW_MS=2000  # free fall only counts if it just preceded impact
FALL_IMPACT_G=2.5             # a brisk sit-down reaches ~1.6 g, so this sits above it
FALL_ORIENTATION_DEG=30       # gravity-direction change that counts as "landed differently"
FALL_STILLNESS_BAND_G=0.12    # how close to 1 g counts as not moving
FALL_STILLNESS_MS=2000        # stillness this long is what separates a fall from a knock
FALL_VERIFICATION_MS=12000    # give up on a candidate impact after this
FALL_WINDOW_MS=10000          # rolling history used to pick an orientation reference
# "Are you okay?" countdown before escalating. Lower it to ~8000 for demos.
FALL_RESPONSE_WINDOW_MS=30000

# ---- NDMA SACHET disaster context (Day 7) ----
# NO API KEY NEEDED. This is a public Government of India feed.
DISASTER_ENABLED=true
SACHET_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
DISASTER_LIVE_WINDOW_MS=1800000   # newer than this is reported LIVE (30 min)
DISASTER_MAX_AGE_MS=21600000      # older than this is reported STALE (6 h)
DISASTER_REFRESH_MS=900000        # how often a fetch may be attempted (15 min)
DISASTER_TIMEOUT_MS=8000
DISASTER_RADIUS_KM=200            # only alerts within this distance of the wearer
DISASTER_LANGUAGE=en              # feed carries en/hi/pa/or; '*' keeps all
# Serve the bundled sample when the network has never succeeded. It is always
# labelled as a sample and can never be reported as live.
DISASTER_ALLOW_SAMPLE=true

# ---- Misc ----
HOST=0.0.0.0
WEATHER_TTL_MS=600000
VERBOSE=false
