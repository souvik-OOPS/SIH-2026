# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL / Supabase) ----
# Supabase -> Project Settings -> Database -> Connection string.
# Leave BLANK to run on the in-memory store (demo still works, data is lost on restart).
#
# IMPORTANT: use the *Session pooler* string, not the direct one. Supabase
# direct connections (db.<ref>.supabase.co:5432) are IPv6-only, and most home
# and college networks are IPv4 — you will get ENETUNREACH. The pooler works
# on both:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase requires TLS. Only set false for a local Postgres without SSL.
DATABASE_SSL=true
# Supabase free tier has a modest connection limit — keep the pool small.
DATABASE_POOL_MAX=5

# ---- Weather / AQI (OpenWeather) ----
# https://openweathermap.org/api  — free tier covers /weather and /air_pollution
OPENWEATHER_API_KEY=
DEFAULT_LAT=22.5726
DEFAULT_LON=88.3639
# Force a fake environment payload for demos (e.g. simulating a heatwave on stage).
# Example: WEATHER_MOCK={"tempC":44,"humidity":68,"aqi":4,"pm25":121,"source":"mock"}
WEATHER_MOCK=

# ---- SMS alerting ----
# One of: console | fast2sms | twilio     (console = dry-run, prints to terminal)
SMS_PROVIDER=console
EMERGENCY_CONTACT=+919999999999

# Fast2SMS (India, free dev credits)
FAST2SMS_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Device auth (simple shared secret for the ESP32) ----
DEVICE_API_KEY=sih26181-dev-key
