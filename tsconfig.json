{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./frontend/*"],
      "@/*": ["./frontend/*"]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.vue"
  ]
}
